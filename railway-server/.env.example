# Pinecone
PINECONE_API_KEY=pcsk_4Xu7Xx_9UdoAJd5pNZjRHfprCpJwwBXn9BaBMesuAvyJZ4GUASj2sxEftJh3X8wxEfHPQY

# Groq (LLM)
GROQ_API_KEY=your_groq_api_key

# Jina AI (Embeddings) — replaces sentence-transformers
JINA_API_KEY=your_jina_api_key

# Optional overrides
EMBEDDING_MODEL=jina-embeddings-v3
CHAT_MODEL=llama-3.3-70b-versatile
INDEX_NAME=proed-chatbot

# RAG settings
RAG_MIN_RELEVANCE_SCORE=0.23
LLM_MIN_INTERVAL_SECONDS=45
LLM_CACHE_TTL_SECONDS=1800
LLM_REQUEST_DELAY_SECONDS=3
STRICT_PART_SCOPE=1
API_WARMUP_ON_START=1

# NOTE: If you previously ingested data using sentence-transformers (384-dim),
# you MUST re-ingest using Jina AI (jina-embeddings-v3 = 1024-dim).
# The Pinecone index dimension will not match otherwise.
# Re-ingest command: python rag_pinecone.py ingest --input data/chunks.json
