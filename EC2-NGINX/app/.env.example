# Copy this file to .env and fill in your actual values
# cp .env.example .env

# Required: Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here

# Required: Groq (used as OpenAI-compatible client)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Model overrides
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHAT_MODEL=llama-3.3-70b-versatile

# Optional: RAG tuning
RAG_MIN_RELEVANCE_SCORE=0.23
LLM_MIN_INTERVAL_SECONDS=45
LLM_REQUEST_DELAY_SECONDS=3
LLM_CACHE_TTL_SECONDS=1800
STRICT_PART_SCOPE=1

# Optional: State/cache paths (defaults work if you keep folder structure)
LLM_STATE_PATH=data/rag_llm_state.json
BM25_CACHE_DIR=data/bm25_cache

# Optional: Disable warmup on startup (set to 0 to speed up cold start)
API_WARMUP_ON_START=1
